# ----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* values are exposed to the browser bundle.
# ----------------------------------------------------------------------------

# Supabase project URL and anon (public) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL, used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private Storage bucket for lab-manual uploads.
SUPABASE_UPLOAD_BUCKET=lab-manuals
